int r= coins.length+1;
       int c = amount+1;
       int dp[][]=new int [r][c];
       for (int i[] : dp){
        Arrays.fill(i, 99999);
       }
       for(int i=0;i<r;i++)
       {
        dp[i][0]=0;
       }
       for(int i=1;i<r;i++)
       {
        for(int j=1;j<c;j++)
        {
            if(j < coins[i-1])
            {
                dp[i][j]=dp[i-1][j];
            }
            else
            {
                dp[i][j]=Math.min(1+dp[i][j-coins[i-1]],dp[i-1][j]);
            }
        }
       }
       if(dp[r-1][c-1]==99999)return -1;
       return dp[r-1][c-1];

    }
}
